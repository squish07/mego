from scipy.stats import f_oneway, chi2_contingency

alpha = 0.05

while True:
    print("\n========== HYPOTHESIS TESTING ==========")
    print("1. One-Way ANOVA")
    print("2. Chi-Square Test")
    print("3. Exit")

    choice = input("\nEnter your choice: ")

    if choice == "1":
        print("\n------ ONE-WAY ANOVA ------")

        group1 = [68,72,65,70,75,71,69,74]
        group2 = [78,80,76,82,79,81,77,84]
        group3 = [60,64,62,65,61,63,66,67]

        f_stat, p_value = f_oneway(group1, group2, group3)

        print("F-Statistic :", round(f_stat, 4))
        print("P-Value :", round(p_value, 6))

        if p_value < alpha:
            print("\nDecision : Reject Null Hypothesis")
            print("Conclusion : At least one group mean is significantly different.")
        else:
            print("\nDecision : Fail to Reject Null Hypothesis")
            print("Conclusion : No significant difference among the groups.")

    elif choice == "2":
        print("\n------ CHI-SQUARE TEST ------")

        table = [
            [30, 20],
            [15, 35]
        ]

        chi2, p_value, dof, expected = chi2_contingency(table)

        print("Chi-Square Statistic :", round(chi2, 4))
        print("Degrees of Freedom :", dof)
        print("P-Value :", round(p_value, 6))

        print("\nExpected Frequencies")
        for row in expected:
            print([round(value, 2) for value in row])

        if p_value < alpha:
            print("\nDecision : Reject Null Hypothesis")
            print("Conclusion : Variables are associated.")
        else:
            print("\nDecision : Fail to Reject Null Hypothesis")
            print("Conclusion : Variables are independent.")

    elif choice == "3":
        print("\nProgram Ended.")
        break

    else:
        print("\nInvalid Choice! Please try again.")
